# =============================================================================
# .env.example — copy to .env and fill in REAL values locally.
#
#   cp .env.example .env
#
# Injected as environment variables at RUNTIME only
# (docker run --env-file .env ... / ECS task-definition secrets).
# Never bake real secrets into the source tree or the Docker image.
# `.env` is git-ignored; only this `.env.example` (placeholders) is committed.
# Keys use Spring relaxed binding, e.g. storage.database.core-db.url -> STORAGE_DATABASE_CORE_DB_URL.
# =============================================================================

# Active profile: local (H2) | local-dev (docker-compose MySQL) | dev | staging | live
SPRING_PROFILES_ACTIVE=dev

# ── Core DB (RDS MySQL) — required for dev / staging / live ──
# URL is host:port/database (no jdbc: prefix, no scheme). local-dev has built-in
# defaults (localhost:3306/core) matching docker-compose, so it needs none of these.
STORAGE_DATABASE_CORE_DB_URL=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/moimyeon
STORAGE_DATABASE_CORE_DB_USERNAME=__CHANGE_ME__
STORAGE_DATABASE_CORE_DB_PASSWORD=__CHANGE_ME__

# ── OAuth2 (Google) — required on every profile (no defaults in config) ──
GOOGLE_OAUTH_CLIENT_ID=__CHANGE_ME__
GOOGLE_OAUTH_CLIENT_SECRET=__CHANGE_ME__

# dev profile defaults to the preview frontend. Set only when intentionally overriding it.
# OAUTH_FRONTEND_SUCCESS_REDIRECT_URI=https://dev.moimyeon.plady.io/auth/callback
# OAUTH_FRONTEND_FAILURE_REDIRECT_URI=https://dev.moimyeon.plady.io/?authError=login_failed

# ── JWT — session token HMAC signing key, >= 32 random bytes (required) ──
JWT_SECRET=__CHANGE_ME__

# ── Optional JVM tuning (overrides the image default) ──
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
