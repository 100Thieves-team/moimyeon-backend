# Terraform
.terraform/
# .terraform.lock.hcl IS committed (provider pinning), like plady.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Generated per-account backend config (bucket name is account-specific).
backend.tf

# Local variable files are ignored by default. Only the three reviewed,
# non-sensitive environment sources below are tracked.
*.tfvars
*.tfvars.json
*.auto.tfvars
terraform.tfvars
!envs/dev/dev.tfvars
!envs/live/live.tfvars
!envs/shared/shared.tfvars

# Plan outputs
*.tfplan
