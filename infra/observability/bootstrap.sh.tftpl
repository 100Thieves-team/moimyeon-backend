#!/usr/bin/env bash
set -euo pipefail
# This file contains no secret values. Terraform only supplies resource identifiers.
umask 027

dnf install -y docker jq xfsprogs
systemctl enable docker
install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --silent --show-error --location --retry 3 \
  https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose.download
echo 'db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576  /usr/local/lib/docker/cli-plugins/docker-compose.download' | sha256sum --check --status
install -m 0755 /usr/local/lib/docker/cli-plugins/docker-compose.download /usr/local/lib/docker/cli-plugins/docker-compose

release_dir='/opt/moimyeon-monitoring/${config_prefix}'
install -d -m 0755 "$release_dir"
cat > "$release_dir/manifest.json" <<'MANIFEST'
${config_manifest_json}
MANIFEST

jq -c '.[]' "$release_dir/manifest.json" | while IFS= read -r asset; do
  path=$(jq -r '.path' <<< "$asset")
  digest=$(jq -r '.sha256' <<< "$asset")
  case "$path" in /*|*..*) exit 1 ;; esac
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || exit 1
  install -d -m 0755 "$(dirname "$release_dir/$path")"
  aws s3 cp 's3://${config_bucket}/${config_prefix}/'"$path" "$release_dir/$path" --region '${region}' --only-show-errors
  printf '%s  %s\n' "$digest" "$release_dir/$path" | sha256sum --check --status
  chmod 0644 "$release_dir/$path"
done
chmod 0755 "$release_dir/start-monitoring.sh"

cat > /etc/systemd/system/moimyeon-monitoring-storage.service <<UNIT
[Unit]
Description=Mount retained monitoring EBS and prepare ephemeral Grafana credential
After=network-online.target
Wants=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$release_dir/start-monitoring.sh '${region}' '${volume_id}' '${grafana_parameter}' prepare
TimeoutStartSec=300s
UNIT
install -d -m 0755 /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/monitoring-storage.conf <<'UNIT'
[Unit]
Requires=moimyeon-monitoring-storage.service
After=moimyeon-monitoring-storage.service
UNIT

cat > /etc/systemd/system/moimyeon-monitoring.service <<UNIT
[Unit]
Description=Moimyeon dev monitoring (private OTLP, Prometheus and Grafana)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$release_dir
ExecStart=$release_dir/start-monitoring.sh '${region}' '${volume_id}' '${grafana_parameter}' run
Environment=MONITORING_DATA_DIR=/var/lib/moimyeon-monitoring
Environment=GRAFANA_ADMIN_PASSWORD_FILE=/run/moimyeon-monitoring/grafana_admin_password
ExecStop=/usr/bin/docker compose -f $release_dir/compose.yaml down --timeout 30
Restart=on-failure
RestartSec=30s
TimeoutStartSec=600s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
# EBS attachment is separate: prepare waits for a bounded 120-second deadline.
# A prepare/dependency failure is fail-closed, not retried by the main unit's
# Restart=on-failure. The runbook requires readiness inspection and operator retry.
systemctl enable moimyeon-monitoring.service
systemctl start --no-block moimyeon-monitoring.service
